      <property name="styleSheet">
       <string notr="true">QFrame#sidebarFrame {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0b1732, stop:0.55 #0f2347, stop:1 #0d1b3a);
  border: none;
  border-right: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel { color: #cdd6ee; background: transparent; }
QPushButton {
  text-align: left;
  color: #aebbe0;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 0px 16px;
  font-size: 10pt;
  min-height: 44px;
}
QPushButton:hover {
  background-color: rgba(255, 255, 255, 0.07);
  color: #ffffff;
}
QPushButton:checked {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
  color: #ffffff;
  font-weight: bold;
}
QPushButton:pressed { background-color: #1e40af; color: #ffffff; }
QPushButton:focus { outline: none; }
QPushButton#btnSair { color: #fca5a5; }
QPushButton#btnSair:hover { background-color: rgba(239, 68, 68, 0.16); color: #fecaca; border: 1px solid rgba(239, 68, 68, 0.28); }
QPushButton#btnSair:pressed { background-color: rgba(239, 68, 68, 0.28); color: #ffffff; }
</string>
