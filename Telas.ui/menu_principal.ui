  border-radius: 10px;
  padding: 0 20px;
  font-size: 10pt;
  font-weight: bold;
  
}
QPushButton:hover { background-color: #f8fafc; border: 1.5px solid #cbd5e1; }
QPushButton:pressed { background-color: #f1f5f9; }
QPushButton:disabled { background-color: #e2e8f0; color: #94a3b8; border-color: #e2e8f0; }
QPushButton:focus { outline: none; }
</string>
