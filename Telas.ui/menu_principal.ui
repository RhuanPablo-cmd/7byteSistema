             <property name="styleSheet">
              <string notr="true">QFrame#cadastroFormFrame {
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
}

QLabel { color: #334155; font-size: 9pt; font-weight: bold; background: transparent; border: none; margin-top: 8px; }
QLineEdit, QComboBox, QDateEdit, QTextEdit {
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  padding: 8px 12px;
  background-color: #ffffff;
  color: #0f172a;
  font-size: 10pt;
  selection-background-color: #bfdbfe;
  selection-color: #0f172a;
}
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QTextEdit:hover { border: 1.5px solid #cbd5e1; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTextEdit:focus { border: 1.5px solid #2563eb; }
QLineEdit:disabled { background-color: #f1f5f9; color: #94a3b8; }
QLineEdit[readOnly="true"] { background-color: #f1f5f9; }
QComboBox::drop-down, QDateEdit::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 32px; border: none; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: none; width: 12px; height: 12px; border: none; background: qconicalgradient(cx:0.5, cy:0.5, angle:45, stop:0 #64748b, stop:0.249 #64748b, stop:0.25 rgba(0,0,0,0), stop:1 rgba(0,0,0,0)); margin-right: 10px; margin-top: 6px; }
QComboBox QAbstractItemView {
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  padding: 4px;
  outline: 0;
  selection-background-color: #eff6ff;
  selection-color: #1e3a8a;
}
</string>
